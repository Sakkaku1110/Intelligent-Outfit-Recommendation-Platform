PORT=3000
PUBLIC_PORT=80
PUBLIC_BASE_URL=http://YOUR_SERVER_IP

# Used by SS928 or admin tools when creating/updating items.
CLOUD_API_KEY=change-me-before-deploy

# Comma-separated origins. Use * during early demo only.
CORS_ORIGIN=*

POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=smart_wardrobe
POSTGRES_USER=wardrobe
POSTGRES_PASSWORD=change-me-db-password

# Optional LLM recommendation service.
# Leave LLM_INFERENCE_URL empty to use the built-in mock/fallback response.
# Set it to your LoRA/model inference HTTP endpoint after training is deployed.
LLM_INFERENCE_URL=
LLM_API_KEY=
LLM_MODEL=outfit-lora-adapter
LLM_FALLBACK=true
